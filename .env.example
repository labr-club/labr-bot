# ── Required ────────────────────────────────────────────────────────────────────

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Quidli Connect API key from https://connect.quid.li
# Required for /scores and /drop. Also covers /lookup (no per-request cost).
QUIDLI_API_KEY=your_quidli_api_key_here

# Quidli Connect MCP server — the bot discovers lookup / scores / balance from here
# at startup. Defaults to the hosted server; override only to point at staging or local.
# CONNECT_MCP_URL=https://mcp.connect.quid.li/

# ── Optional ────────────────────────────────────────────────────────────────────

# Claude model to use. Defaults to claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# Override the bot's default personality/instructions
SYSTEM_PROMPT=

# Labr: read the prompt from a file in the bot's directory instead. Wins over
# SYSTEM_PROMPT. The Labr instance uses labr-prompt.txt.
# SYSTEM_PROMPT_FILE=labr-prompt.txt

# Labr: comma-separated server (guild) IDs the bot may stay in. It leaves every
# other server. Empty = any server.
# DISCORD_ALLOWED_GUILDS=

# Labr: 'false' = the owner pays from their own linked key like everyone else,
# and the host QUIDLI_API_KEY never pays for a send. Default 'true'.
# OWNER_USES_HOST_KEY=false

# Labr: sends above these USD amounts wait for !confirm. 0 turns a limit off.
# MAX_SEND_USD=50
# DAILY_SEND_USD=200

# Comma-separated Discord channel IDs where the bot responds to ALL messages.
# If empty, the bot only responds when @mentioned.
DISCORD_ACTIVE_CHANNELS=

# Comma-separated Discord user IDs allowed to use the bot.
# If empty, anyone can use it.
DISCORD_ALLOWED_USERS=

# Comma-separated Discord role names allowed to use the bot.
# If empty, anyone can use it. Example: Team Quidli,Admins
DISCORD_ALLOWED_ROLES=

# Your Discord user ID — drops from your account use the host QUIDLI_API_KEY automatically.
# Find your ID: Discord Settings → Advanced → Enable Developer Mode → right-click yourself → Copy User ID
BOT_OWNER_ID=

# ── Per-user key encryption ───────────────────────────────────────────────────

# 32-byte hex key used to AES-256-GCM encrypt stored user API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, keys are stored in plaintext (not recommended for production).
MASTER_ENCRYPTION_KEY=

# ── Web search (required for conditional drops) ───────────────────────────────

# Brave Search API key from https://brave.com/search/api
BRAVE_SEARCH_API_KEY=

# ── Multi-LLM provider switching ─────────────────────────────────────────────

# Default LLM provider: anthropic (recommended), gemini, openai, or hermes
DEFAULT_LLM_PROVIDER=anthropic

# Gemini — from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — from https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Hermes / Nous Portal — from https://portal.nousresearch.com (API keys tab)
# Portal is an OpenAI-compatible gateway to 200+ models. Slugs are vendor-prefixed,
# and free variants carry a ':free' suffix.
# Don't trust a list of "known good" free models — Nous retires them without notice,
# and a stale list is what took the bots down when tencent/hy3:free vanished.
# Check what's live, then confirm it calls tools before switching:
#   curl -s https://inference-api.nousresearch.com/v1/models \
#     -H "Authorization: Bearer $NOUS_API_KEY" | grep -o '"id":"[^"]*"' | grep free
# Paid tiers can use any slug (anthropic/claude-sonnet-4.6, openai/gpt-5.5, ...).
# Users can bring their own key and model by DMing: !llm hermes <key> <model>
NOUS_API_KEY=
NOUS_MODEL=poolside/laguna-s-2.1:free

# ── Host key protection ──────────────────────────────────────────────────────
# The host's LLM keys (Anthropic/Gemini/OpenAI/Nous above) are spendable ONLY by
# BOT_OWNER_ID plus anyone listed here. Everyone else must connect their own key
# for the provider in use, or they're told to ask you for authorization.
# Leave both empty for owner-only.
# Comma-separated @handles and/or numeric user IDs:
HOST_KEY_ALLOWED_USERS=
# Comma-separated Discord role names whose members may use the host's keys:
HOST_KEY_ALLOWED_ROLES=

# Token access (Labr). Off unless ACCESS_TOKEN is set. Members whose Discord
# resolves (in Connect) to a wallet holding ACCESS_MIN get ACCESS_ROLE, may use
# the host's AI keys up to a daily cap set by ACCESS_AI_TIERS (held:messages per
# day, UTC), and can be paid by the treasury payout tool.
# ACCESS_TOKEN=0x...
# ACCESS_CHAIN_ID=8453
# ACCESS_RPC_URL=https://mainnet.base.org
# ACCESS_MIN=1000
# ACCESS_ROLE=Holder
# ACCESS_AI_TIERS=1000:20,10000:100,100000:500
# ACCESS_RECHECK_MIN=360

# Contributor payouts are approved with the !confirm code by default.
# World ID approval is optional: set PAYOUT_APPROVAL=world_id and fill in the
# WORLD_ID_* values below (see README, "World ID approval"). With world_id set
# but not configured, payouts are disabled rather than falling back.
# PAYOUT_APPROVAL=confirm
# Payouts are disabled until the first three are set. Register an app at
# https://auth.world.org/portal (client_secret_post), then enrol a treasurer on
# the host with: node scripts/world-enroll.mjs
WORLD_ID_CLIENT_ID=
WORLD_ID_CLIENT_SECRET=
WORLD_ID_TREASURER_SUBS=
# Optional. Sandbox: https://sandbox.auth.world.org
# WORLD_ID_ISSUER=https://auth.world.org
# Optional. Comma-separated acr class URLs to accept (default: Orb only)
# WORLD_ID_ACCEPTED_ACR=https://world.org/oidc/acr/orb
